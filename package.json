{
    "name": "hino-repository",
    "private": true,
    "type": "module",
    "license": "MIT",
    "packageManager": "bun@1.4.2",
    "workspaces": [
        "packages/*",
        "www"
    ],
    "scripts": {
        "typecheck": "bun run --filter '@phe-rus/*' typecheck && bun run --cwd www typecheck",
        "test": "bun run --filter '@phe-rus/*' test && bun run --cwd www test",
        "publish:check": "bun run --filter '@phe-rus/*' publish:check",
        "build:website": "bun run --cwd www build",
        "lint": "vp lint",
        "format": "vp fmt",
        "check": "vp check"
    },
    "overrides": {
        "vite": "npm:@voidzero-dev/vite-plus-core@1.2.0"
    },
    "devDependencies": {
        "vite": "npm:@voidzero-dev/vite-plus-core@1.2.0",
        "vite-plus": "1.2.0"
    }
}
