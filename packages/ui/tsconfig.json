{
    "compilerOptions": {
        "target": "ES2023",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "skipLibCheck": true,
        "noEmit": true,
        "lib": ["ES2023", "DOM", "DOM.Iterable"],
        "jsx": "react-jsx",
        "types": ["node"]
    },
    "include": [
        "src",
        "test",
        "tokens/src",
        "tokens/scripts",
        "tokens/test"
    ]
}
