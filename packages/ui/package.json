        "./tab-view": "./src/components/tab-view/tab-view.tsx",
        "./sidebar": "./src/components/sidebar/sidebar.tsx",
        "./icon-button": "./src/components/button/icon-button.tsx",
        "./secure-field": "./src/components/secure-field/secure-field.tsx",
