{
    "include": ["**/*.ts", "**/*.tsx"],
    "compilerOptions": {
        "target": "ES2022",
        "types": ["bun"],
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "skipLibCheck": true,
        "strict": true,
        "noEmit": true
    },
    "exclude": ["node_modules", "dist"]
}
